<persistence xmlns="http://java.sun.com/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://java.sun.com/xml/ns/persistence http://java.sun.com/xml/ns/persistence/persistence_2_0.xsd"
             version="2.0">

    <persistence-unit name="myapp.utils.entitymanager.jpa">
        <description>
            Persistence unit for JPA Hibernate PostgreSQL mapping
        </description>

        <class>myapp.model.Employee</class>
        <class>myapp.model.Department</class>

        <properties>
            <!-- JDBC настройки -->
            <property name="javax.persistence.jdbc.driver" value="org.postgresql.Driver" />
            <property name="javax.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/departments" />
            <property name="javax.persistence.jdbc.user" value="dep" />
            <property name="javax.persistence.jdbc.password" value="dep" />

            <!-- Диалект PostgreSQL -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect" />

            <!-- Автообновление схемы (можно удалить в продакшене) -->
            <property name="hibernate.hbm2ddl.auto" value="update" />

            <!-- Логирование SQL-запросов -->
            <property name="hibernate.show_sql" value="true" />
            <property name="hibernate.format_sql" value="true" />
        </properties>

    </persistence-unit>

</persistence>